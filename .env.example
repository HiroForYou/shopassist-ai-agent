# --- Ollama ---
# Local (env_ml): http://localhost:11434 | Dentro de docker compose se sobrescribe a http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# Modelo alternativo: comparaciones (Fase 4) y fallback (Fase 6)
OLLAMA_FALLBACK_MODEL=granite4.1:3b
OLLAMA_TEMPERATURE=0
# false = sin modo "thinking" (en CPU dispara la latencia). true para comparar calidad vs latencia
OLLAMA_REASONING=false
# Embeddings multilingues para RAG (Fase 3)
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# --- LLM-as-judge (Fase 4) --- vacio = mismo modelo del agente (sesgo de auto-preferencia)
JUDGE_MODEL=
JUDGE_REASONING=false

# --- Observabilidad (Fase 5) ---
# Logs JSON en logs/shopassist.jsonl
OBS_ENABLED=true
# Tarifa HIPOTETICA (USD por 1M tokens) para estimar costo como API de pago; con Ollama el costo real es infra
COST_INPUT_PER_1M=1.0
COST_OUTPUT_PER_1M=4.0
# llm = baseline Fase 4 | hybrid = reglas deterministas + LLM como fallback
ROUTER_MODE=llm

# --- Qdrant (Fase 3) ---
# Local (env_ml): http://localhost:6333 | Dentro de docker compose se sobrescribe a http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=shop_policies
RAG_TOP_K=3
# Similitud coseno minima; calibrar con: python scripts/fase3_eval.py retrieval
RAG_SCORE_THRESHOLD=0.40

# --- LangSmith (https://smith.langchain.com -> Settings -> API Keys) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_xxx
LANGSMITH_PROJECT=ai-agentic
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Dominio ---
# Fecha simulada: hace reproducibles las reglas de reembolso (clave para evals/regression en Fase 4)
APP_TODAY=2026-09-24
